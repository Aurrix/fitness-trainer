{
  "name": "fitness-trainer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "enrich:exercises": "node scripts/enrich-exercises.js",
    "generate:strength-benchmarks": "node scripts/generate-strength-benchmarks.js",
    "sync:content": "node scripts/normalize-content-assets.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "import:exercises": "node scripts/import-exercises.mjs",
    "engine:build": "node scripts/program-import/validate-native.mjs",
    "import:programs": "node scripts/program-import/native.mjs && node scripts/program-import/validate-native.mjs",
    "test:engine": "node --test tests/training-engine.test.mjs tests/native-training.test.mjs tests/native-advanced.test.mjs tests/native-migration.test.mjs",
    "programs:convert-native": "node scripts/program-import/complete-native.mjs",
    "reference:engine:build": "node scripts/program-import/build-engine.mjs",
    "reference:import:programs": "node scripts/program-import/import.mjs && node scripts/program-import/native.mjs && node scripts/program-import/convert-native.mjs && node scripts/program-import/complete-native.mjs",
    "test:engine:parity": "node --test tests/native-parity.test.mjs tests/native-program-cycles.test.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@lezer/common": "^1.5.5",
    "@lezer/highlight": "^1.2.5",
    "@lezer/lr": "^1.4.12",
    "@mjcdev/react-body-highlighter": "^0.0.4",
    "@mui/material": "^9.0.0",
    "@mui/x-charts": "^9.0.2",
    "deepmerge": "^4.3.1",
    "dequal": "^2.0.3",
    "dexie": "^4.4.2",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "fp-ts": "^2.16.11",
    "io-ts": "^2.2.22",
    "lens-shmens": "^1.6.0",
    "lucide-react": "^1.11.0",
    "micro-memoize": "^4.2.0",
    "react": "^19.2.5",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^19.2.5",
    "valibot": "^1.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "workbox-build": "^7.4.0"
  }
}
