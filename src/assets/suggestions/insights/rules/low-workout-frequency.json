{
  "id": "low-workout-frequency",
  "title": "Training frequency is below plan",
  "category": "consistency",
  "tone": "attention",
  "priority": 85,
  "variables": {
    "actualSessions": {
      "keyword": "weeklySessionAverage",
      "options": {
        "lookbackWeeks": 6
      }
    },
    "recentWeekCount": {
      "keyword": "recentWeeklySessionCount",
      "options": {
        "lookbackWeeks": 6
      }
    },
    "targetSessions": {
      "keyword": "plannedSessionsPerWeek"
    },
    "targetThreshold": {
      "keyword": "multiply",
      "args": [
        {
          "var": "targetSessions"
        },
        0.7
      ]
    },
    "weeklySessionTotal": {
      "keyword": "weeklySessionTotal",
      "options": {
        "lookbackWeeks": 6
      }
    },
    "actualSessionsRounded": {
      "keyword": "formatNumber",
      "args": [
        {
          "var": "actualSessions"
        }
      ],
      "options": {
        "digits": 1
      }
    }
  },
  "when": {
    "all": [
      {
        "gte": [
          {
            "var": "targetSessions"
          },
          2
        ]
      },
      {
        "gte": [
          {
            "var": "recentWeekCount"
          },
          3
        ]
      },
      {
        "lt": [
          {
            "var": "actualSessions"
          },
          {
            "var": "targetThreshold"
          }
        ]
      }
    ]
  },
  "details": [
    "Recent window: {{recentWeekCount}} weeks.",
    "Completed volume: {{weeklySessionTotal}} sessions."
  ],
  "messages": {
    "summary": "You are averaging {{actualSessionsRounded}} sessions per week against a target of {{targetSessions}}.",
    "action": "Add one short session or split a long day to move closer to the planned weekly rhythm."
  }
}
